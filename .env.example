# ─── Base de données ─────────────────────────────────────────────────────────
# Neon (production) :
#   DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Développement local sans PostgreSQL : laisser vide => PGlite (PostgreSQL en WASM)
DATABASE_URL=""

# Dossier de données PGlite (développement local uniquement)
PGLITE_DIR=".data/pg"

# ─── Authentification ────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
AUTH_SECRET="changez-moi-en-production"

# Numéros administrateurs, séparés par des virgules (format libre : 0700000000)
ADMIN_PHONES="0700000000"

# ─── Abonnement sans API (liens Wave de paiement) ────────────────────────────
WAVE_LINK_PRO="https://pay.wave.com/m/xxxx-pro"
WAVE_LINK_BUSINESS="https://pay.wave.com/m/xxxx-business"

# ─── Application ─────────────────────────────────────────────────────────────
# URL publique utilisée pour les liens de partage /d/[token]
APP_URL="http://localhost:3000"

# ─── Seed du compte administrateur (scripts/seed.ts) ─────────────────────────
ADMIN_PASSWORD="Admin1234!"
ADMIN_NAME="Administrateur FactureCI"

# ─── E-mail (facultatif, version 2) ──────────────────────────────────────────
# RESEND_API_KEY=""
# RESEND_FROM="FactureCI <factures@votre-domaine.ci>"
